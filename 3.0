/* =============================================================================
   JOB DE HOMOLOGACIÓN DE PRECIOS - XposStore (n cajas)
   Se instala y se ejecuta en la base XposStore de la caja servidora (Caja 2).

   Cajas: se leen de dbo.Till (IS_ACTIVE = 1) en cada ejecución.
     - La caja con IS_SERVER = 1 es la local (la base donde corre el job).
     - Las demás se localizan con las plantillas de la sección CONFIGURACIÓN,
       usando {n} = CASH_NUMBER y {name} = NAME de Till.
     - Una caja nueva en Till se incluye sola. Con @crear_servidores = 1, el
       job crea su servidor vinculado a partir de NAME si todavía no existe.

   Flujo (según la especificación):
     1. Lock: si ya hay una ejecución en curso, esta se omite.
     2. Validar la conexión a todas las cajas. Si falla alguna: registrar
        "Error de conectividad" y cancelar todo el proceso.
     3. Ejecutar la consulta de precios en cada caja.
     4. Consolidar la tabla comparativa por SKU y typePrice.
     5. Si no hay SKUs con estatus 'DIFERENTES': registrar "Precios homologados".
     6. Por cada SKU deshomologado:
          - Precio ganador: el de la fecha más reciente (creado/modificado).
          - UPDATE en las cajas con el precio desactualizado.
          - Registrar en la tabla de auditoría.

   @SoloReporte = 1 (valor por defecto): solo muestra la tabla de lo que se
   cambiaría. No modifica precios ni escribe en la auditoría.
   @SoloReporte = 0: aplica los cambios.

   Casos que no se actualizan y se marcan para revisar:
     - El SKU no existe en alguna caja.
     - Empate: la fecha más reciente tiene precios distintos.
     - Un SKU tiene más de un precio activo del mismo tipo en una caja.
   ============================================================================= */

USE XposStore_50LP1_P2;   -- Caja servidora. En producción: su base XposStore
GO

/* -----------------------------------------------------------------------------
   Auditoría: una fila por SKU y caja actualizada
   (si existe la versión anterior de 3 columnas fijas, se conserva renombrada)
   ----------------------------------------------------------------------------- */
IF COL_LENGTH(N'dbo.Job_Homologacion_Precios_Log', N'Previous_Caja1_Price') IS NOT NULL
    EXEC sp_rename N'dbo.Job_Homologacion_Precios_Log', N'Job_Homologacion_Precios_Log_v1';

IF OBJECT_ID(N'dbo.Job_Homologacion_Precios_Log') IS NULL
CREATE TABLE dbo.Job_Homologacion_Precios_Log (
    LogID               BIGINT IDENTITY(1,1) PRIMARY KEY,
    EjecucionID         INT            NULL,
    ExecutionDate       DATETIME       NOT NULL DEFAULT GETDATE(),
    SKU                 VARCHAR(100)   NOT NULL,
    PriceType           VARCHAR(50)    NOT NULL,
    Caja                VARCHAR(20)    NOT NULL,   -- caja actualizada
    Previous_Price      DECIMAL(18,4)  NULL,
    Winning_Price       DECIMAL(18,4)  NOT NULL,
    Winning_Source_Caja VARCHAR(200)   NOT NULL,
    Winning_Date        DATETIME       NULL,
    Status              VARCHAR(20)    NOT NULL,   -- ACTUALIZADO / ERROR
    Error_Message       NVARCHAR(4000) NULL
);

/* -----------------------------------------------------------------------------
   Bitácora de ejecuciones: conectividad, cancelaciones y resultado del job
   ----------------------------------------------------------------------------- */
IF OBJECT_ID(N'dbo.Job_Homologacion_Precios_Ejecucion') IS NULL
CREATE TABLE dbo.Job_Homologacion_Precios_Ejecucion (
    EjecucionID       INT IDENTITY(1,1) PRIMARY KEY,
    ExecutionDate     DATETIME     NOT NULL DEFAULT GETDATE(),
    Modo              VARCHAR(10)  NOT NULL,   -- REPORTE / CORRECCION
    Status            VARCHAR(20)  NOT NULL,   -- OK / CANCELADO / OMITIDO / PARCIAL / ERROR
    SKUs_Diferentes   INT NULL,
    SKUs_Actualizar   INT NULL,
    SKUs_Por_Revisar  INT NULL,
    SKUs_Con_Error    INT NULL,
    Mensaje           NVARCHAR(4000) NULL
);
GO


CREATE OR ALTER PROCEDURE dbo.usp_Job_Homologacion_Precios
    @SoloReporte BIT = 1
AS
BEGIN
    SET NOCOUNT ON;
    SET XACT_ABORT ON;

    /* =========================================================================
       CONFIGURACIÓN
       Ubicación de las cajas que no son servidor. {n} = CASH_NUMBER, {name} = NAME.

       Ambiente de pruebas (todas las bases en la misma instancia):
           @plantilla_servidor  = NULL
           @plantilla_base      = N'XposStore_50LP1_v{n}'
           @crear_servidores    = 0
       Producción (un servidor vinculado por caja con el NAME de Till):
           @plantilla_servidor  = N'{name}'
           @plantilla_base      = N'XposStore'
           @crear_servidores    = 1
           @plantilla_instancia = N'{name}\SQLEXPRESS'   -- equipo\instancia de cada caja
       ========================================================================= */
    DECLARE @plantilla_servidor  SYSNAME       = NULL,
            @plantilla_base      SYSNAME       = N'XposStore_50LP1_v{n}',
            @crear_servidores    BIT           = 0,
            @plantilla_instancia NVARCHAR(200) = N'{name}\SQLEXPRESS',
            @proveedor           SYSNAME       = N'MSOLEDBSQL';

    declare @price_types table (priceType varchar(100))

    insert into @price_types
    select 'SALE_PRICE'
    --insert into @price_types
    --select 'COST_PRICE'
    --insert into @price_types
    --select 'LOW_PRICE'

    /* ========================================================================= */

    CREATE TABLE #cajas (
        cash_number INT            NOT NULL PRIMARY KEY,
        caja        VARCHAR(20)    NOT NULL,     -- 'Caja' + CASH_NUMBER
        es_servidor BIT            NOT NULL,
        nombre      VARCHAR(100)   NULL,         -- NAME de Till
        servidor    SYSNAME        NULL,         -- servidor vinculado (NULL = local)
        prefijo     NVARCHAR(400)  NULL,         -- [servidor].[base].dbo.
        en_linea    BIT            NULL,
        error       NVARCHAR(4000) NULL
    );
    CREATE TABLE #precios (
        caja              VARCHAR(20)   NOT NULL,
        sku               VARCHAR(100)  NOT NULL,
        price             DECIMAL(16,4) NULL,
        typePrice         VARCHAR(50)   NOT NULL,
        modified_datetime DATETIME      NULL,
        created_datetime  DATETIME      NULL
    );

    DECLARE @EjecucionID INT,
            @Modo        VARCHAR(10) = CASE WHEN @SoloReporte = 1 THEN 'REPORTE' ELSE 'CORRECCION' END,
            @Status      VARCHAR(20),
            @Mensaje     NVARCHAR(4000),
            @Lock        INT,
            @n           INT,
            @caja        VARCHAR(20),
            @prefijo     NVARCHAR(400),
            @tipos       NVARCHAR(MAX),
            @query       NVARCHAR(MAX),
            @update      NVARCHAR(MAX),
            @sql         NVARCHAR(MAX),
            @cols_precio NVARCHAR(MAX),
            @cols_fecha  NVARCHAR(MAX),
            @servidor    SYSNAME,
            @instancia   NVARCHAR(200);

    /* -------------------------------------------------------------------------
       1. Lock: solo una ejecución a la vez
       ------------------------------------------------------------------------- */
    EXEC @Lock = sp_getapplock @Resource    = N'Job_Homologacion_Precios',
                               @LockMode    = N'Exclusive',
                               @LockOwner   = N'Session',
                               @LockTimeout = 0;
    IF @Lock < 0
    BEGIN
        INSERT dbo.Job_Homologacion_Precios_Ejecucion (Modo, Status, Mensaje)
        VALUES (@Modo, 'OMITIDO', N'Ya hay una ejecución en curso.');
        RAISERROR(N'Ya hay una ejecución en curso. Esta ejecución se omite.', 10, 1) WITH NOWAIT;
        RETURN 1;
    END

    BEGIN TRY
        INSERT dbo.Job_Homologacion_Precios_Ejecucion (Modo, Status) VALUES (@Modo, 'EN_CURSO');
        SET @EjecucionID = SCOPE_IDENTITY();

        /* ---------------------------------------------------------------------
           Cajas activas desde Till
           --------------------------------------------------------------------- */
        IF EXISTS (SELECT CASH_NUMBER FROM dbo.Till WHERE IS_ACTIVE = 1
                   GROUP BY CASH_NUMBER HAVING COUNT(*) > 1)
            THROW 50001, N'Till tiene CASH_NUMBER repetidos entre las cajas activas.', 1;
        IF (SELECT COUNT(*) FROM dbo.Till WHERE IS_ACTIVE = 1 AND IS_SERVER = 1) <> 1
            THROW 50002, N'Till debe tener exactamente una caja activa con IS_SERVER = 1.', 1;

        INSERT #cajas (cash_number, caja, es_servidor, nombre, servidor, prefijo)
        SELECT t.CASH_NUMBER,
               'Caja' + CAST(t.CASH_NUMBER AS VARCHAR(10)),
               t.IS_SERVER,
               LTRIM(RTRIM(t.NAME)),
               s.servidor,
               CASE WHEN t.IS_SERVER = 1
                    THEN QUOTENAME(DB_NAME()) + N'.dbo.'
                    ELSE ISNULL(QUOTENAME(s.servidor) + N'.', N'')
                         + QUOTENAME(REPLACE(REPLACE(@plantilla_base, N'{n}', t.CASH_NUMBER),
                                             N'{name}', LTRIM(RTRIM(t.NAME)))) + N'.dbo.'
               END
        FROM dbo.Till AS t
        CROSS APPLY (SELECT CASE WHEN t.IS_SERVER = 0
                                 THEN REPLACE(REPLACE(@plantilla_servidor, N'{n}', t.CASH_NUMBER),
                                              N'{name}', LTRIM(RTRIM(t.NAME))) END AS servidor) AS s
        WHERE t.IS_ACTIVE = 1;

        IF (SELECT COUNT(*) FROM #cajas) < 2
            THROW 50003, N'Se requieren al menos dos cajas activas en Till.', 1;

        /* ---------------------------------------------------------------------
           Caja nueva en Till: crear su servidor vinculado si no existe
           --------------------------------------------------------------------- */
        IF @crear_servidores = 1
        BEGIN
            SET @n = (SELECT MIN(cash_number) FROM #cajas
                      WHERE servidor IS NOT NULL
                        AND NOT EXISTS (SELECT 1 FROM sys.servers WHERE name = servidor));
            WHILE @n IS NOT NULL
            BEGIN
                SELECT @servidor  = servidor,
                       @instancia = REPLACE(REPLACE(@plantilla_instancia, N'{n}', cash_number),
                                            N'{name}', nombre)
                FROM #cajas WHERE cash_number = @n;
                BEGIN TRY
                    EXEC sp_addlinkedserver @server = @servidor, @srvproduct = N'',
                         @provider = @proveedor, @datasrc = @instancia,
                         @provstr = N'Encrypt=yes;TrustServerCertificate=yes';
                    -- Usa las credenciales con las que se ejecuta el job (ver PRODUCCIÓN)
                    EXEC sp_addlinkedsrvlogin @rmtsrvname = @servidor, @useself = N'TRUE';
                    EXEC sp_serveroption @servidor, 'connect timeout', '10';
                    EXEC sp_serveroption @servidor, 'query timeout', '300';
                END TRY
                BEGIN CATCH
                    UPDATE #cajas
                       SET en_linea = 0,
                           error = N'No se pudo crear el servidor vinculado ' + @servidor
                                 + N': ' + ERROR_MESSAGE()
                    WHERE cash_number = @n;
                END CATCH;
                SET @n = (SELECT MIN(cash_number) FROM #cajas
                          WHERE cash_number > @n AND servidor IS NOT NULL
                            AND NOT EXISTS (SELECT 1 FROM sys.servers WHERE name = servidor));
            END
        END

        /* ---------------------------------------------------------------------
           2. Validar conexión a todas las cajas
           --------------------------------------------------------------------- */
        SET @n = (SELECT MIN(cash_number) FROM #cajas);
        WHILE @n IS NOT NULL
        BEGIN
            SET @sql = N'select top (0) 1 from ' + (SELECT prefijo FROM #cajas WHERE cash_number = @n) + N'PRICE';
            BEGIN TRY
                IF EXISTS (SELECT 1 FROM #cajas WHERE cash_number = @n AND en_linea = 0)
                    THROW 50004, N'Servidor vinculado no disponible.', 1;
                SET @servidor = (SELECT servidor FROM #cajas WHERE cash_number = @n);
                IF @servidor IS NOT NULL
                   AND NOT EXISTS (SELECT 1 FROM sys.servers WHERE name = @servidor)
                BEGIN
                    SET @Mensaje = N'No existe el servidor vinculado ' + @servidor + N'.';
                    THROW 50005, @Mensaje, 1;
                END
                EXEC (@sql);
                UPDATE #cajas SET en_linea = 1 WHERE cash_number = @n;
            END TRY
            BEGIN CATCH
                UPDATE #cajas SET en_linea = 0, error = ISNULL(error, ERROR_MESSAGE())
                WHERE cash_number = @n;
            END CATCH;
            SET @n = (SELECT MIN(cash_number) FROM #cajas WHERE cash_number > @n);
        END

        /* ---------------------------------------------------------------------
           3. Consulta de precios en cada caja
           --------------------------------------------------------------------- */
        IF NOT EXISTS (SELECT 1 FROM #cajas WHERE en_linea = 0)
        BEGIN
            SELECT @tipos = STRING_AGG(CAST('''' + REPLACE(priceType, '''', '''''') + ''''
                                            AS NVARCHAR(MAX)), ',')
            FROM @price_types;

            SET @query = N'
            select {caja}, i.SKU,AMOUNT,pt.NAME,p.modified_datetime,p.created_datetime from {db}item as i
            inner join {db}ITEM_BUSINESS_UNIT_LINK as il on il.ITEM_ID = i.ITEM_ID
            inner join {db}PRICE as p on p.ITEM_BUSINESS_UNIT_LINK_ID = il.ITEM_BUSINESS_UNIT_LINK_ID
            inner join {db}code as pt on pt.CODE_ID = p.PRICE_TYPE_CODE_ID
            inner join {db}code as it on it.CODE_ID = i.ITEM_TYPE_CODE_ID
            where
                i.IS_ACTIVE = 1 and
                p.IS_ACTIVE = 1 and
                it.NAME = ''PRODUCT_ITEM'' and
                pt.NAME in ({tipos})';
            SET @query = REPLACE(@query, N'{tipos}', @tipos);

            SET @n = (SELECT MIN(cash_number) FROM #cajas);
            WHILE @n IS NOT NULL
            BEGIN
                SELECT @caja = caja, @prefijo = prefijo FROM #cajas WHERE cash_number = @n;
                SET @sql = REPLACE(REPLACE(@query, N'{db}', @prefijo),
                                   N'{caja}', QUOTENAME(@caja, ''''));
                BEGIN TRY
                    insert into #precios exec (@sql);
                END TRY
                BEGIN CATCH
                    UPDATE #cajas SET en_linea = 0, error = ERROR_MESSAGE() WHERE cash_number = @n;
                    BREAK;   -- una caja falló: se cancela todo
                END CATCH;
                SET @n = (SELECT MIN(cash_number) FROM #cajas WHERE cash_number > @n);
            END
        END

        /* ---------------------------------------------------------------------
           Falla de conexión: registrar y cancelar el proceso completo
           --------------------------------------------------------------------- */
        IF EXISTS (SELECT 1 FROM #cajas WHERE en_linea = 0)
        BEGIN
            SELECT @Status  = 'CANCELADO',
                   @Mensaje = N'Error de conectividad. Proceso cancelado. '
                            + STRING_AGG(CAST(caja + N': ' + error AS NVARCHAR(MAX)), N' | ')
            FROM #cajas
            WHERE en_linea = 0;

            UPDATE dbo.Job_Homologacion_Precios_Ejecucion
               SET Status = @Status, Mensaje = @Mensaje
            WHERE EjecucionID = @EjecucionID;

            SELECT caja AS Caja,
                   nombre AS Nombre,
                   CASE en_linea WHEN 1 THEN 'EN LINEA'
                                 WHEN 0 THEN 'SIN CONEXION'
                                 ELSE 'NO VALIDADA' END AS Estado,
                   prefijo AS Base,
                   error AS Error
            FROM #cajas
            ORDER BY cash_number;
        END
        ELSE
        BEGIN
            /* -----------------------------------------------------------------
               4. Tabla comparativa por SKU y typePrice
               ----------------------------------------------------------------- */
            -- Detalle: una fila por SKU, typePrice y caja (filas NULL = no existe)
            with TodosLosProductos as (
                select distinct sku, typePrice from #precios
            )
            select t.sku, t.typePrice, c.cash_number, c.caja,
                   p.filas, p.price, p.fecha
            into #detalle
            from TodosLosProductos as t
            cross join #cajas as c
            outer apply (select count(*) as filas,
                                max(x.price) as price,
                                max(case when x.modified_datetime is null
                                          or x.created_datetime > x.modified_datetime
                                         then x.created_datetime else x.modified_datetime end) as fecha
                         from #precios as x
                         where x.sku = t.sku and x.typePrice = t.typePrice and x.caja = c.caja
                         having count(*) > 0) as p;

            select d.sku, d.typePrice,
                   case when sum(case when d.filas = 1 then 0 else 1 end) = 0
                         and count(distinct isnull(d.price, -1)) = 1
                        then 'ESTAN IGUALES' else 'DIFERENTES' end as Estatus_Precios,
                   cast(null as decimal(16,4)) as Precio_Ganador,
                   cast(null as varchar(200))  as Caja_Ganadora,
                   cast(null as datetime)      as Fecha_Ganadora,
                   cast(null as varchar(500))  as Cajas_Actualizar,
                   cast(null as varchar(1000)) as Accion,
                   cast(null as varchar(20))   as Resultado
            into #comparativa
            from #detalle as d
            group by d.sku, d.typePrice;

            /* -----------------------------------------------------------------
               5. Precio ganador: fecha de creación/modificación más reciente
                  (no aplica si hay duplicados o empate)
               ----------------------------------------------------------------- */
            update c
               set Precio_Ganador = g.price,
                   Caja_Ganadora  = g.cajas,
                   Fecha_Ganadora = m.fecha_max
            from #comparativa as c
            cross apply (select max(d.fecha) as fecha_max
                         from #detalle as d
                         where d.sku = c.sku and d.typePrice = c.typePrice
                           and d.filas = 1 and d.fecha is not null) as m
            cross apply (select count(distinct d.price) as precios,
                                min(d.price) as price,
                                string_agg(d.caja, ',') within group (order by d.cash_number) as cajas
                         from #detalle as d
                         where d.sku = c.sku and d.typePrice = c.typePrice
                           and d.filas = 1 and d.fecha = m.fecha_max) as g
            where c.Estatus_Precios = 'DIFERENTES'
              and g.precios = 1
              and not exists (select 1 from #detalle as d
                              where d.sku = c.sku and d.typePrice = c.typePrice and d.filas > 1);

            -- Cajas con el precio desactualizado
            update c
               set Cajas_Actualizar = u.cajas
            from #comparativa as c
            cross apply (select string_agg(d.caja, ',') within group (order by d.cash_number) as cajas
                         from #detalle as d
                         where d.sku = c.sku and d.typePrice = c.typePrice
                           and d.filas = 1 and d.price <> c.Precio_Ganador) as u
            where c.Precio_Ganador is not null;

            -- Acción a tomar
            update c
               set Accion = case
                       when c.Estatus_Precios = 'ESTAN IGUALES' then 'Sin cambio'
                       when dup.cajas is not null then 'REVISAR: precio duplicado en ' + dup.cajas
                       when c.Precio_Ganador is null then 'REVISAR: empate de fecha con precios distintos'
                       else concat_ws('; ',
                            case when c.Cajas_Actualizar is not null
                                 then 'UPDATE ' + c.Cajas_Actualizar + ' a $'
                                      + convert(varchar(30), cast(c.Precio_Ganador as decimal(16,2))) end,
                            case when falta.cajas is not null
                                 then 'REVISAR: no existe en ' + falta.cajas end)
                   end
            from #comparativa as c
            outer apply (select string_agg(d.caja, ',') within group (order by d.cash_number) as cajas
                         from #detalle as d
                         where d.sku = c.sku and d.typePrice = c.typePrice and d.filas > 1) as dup
            outer apply (select string_agg(d.caja, ',') within group (order by d.cash_number) as cajas
                         from #detalle as d
                         where d.sku = c.sku and d.typePrice = c.typePrice and d.filas is null) as falta;

            update #comparativa
               set Resultado = case when Accion like 'UPDATE%'   then 'PENDIENTE'
                                    when Accion like '%REVISAR%' then 'REVISAR' end
            where Estatus_Precios = 'DIFERENTES';

            /* -----------------------------------------------------------------
               6. UPDATE por SKU en las cajas desactualizadas (solo @SoloReporte = 0)
               ----------------------------------------------------------------- */
            IF @SoloReporte = 0
            BEGIN
                SET @update = N'
                update p set p.AMOUNT = @price, p.modified_datetime = @fecha
                from {db}item as i
                inner join {db}ITEM_BUSINESS_UNIT_LINK as il on il.ITEM_ID = i.ITEM_ID
                inner join {db}PRICE as p on p.ITEM_BUSINESS_UNIT_LINK_ID = il.ITEM_BUSINESS_UNIT_LINK_ID
                inner join {db}code as pt on pt.CODE_ID = p.PRICE_TYPE_CODE_ID
                inner join {db}code as it on it.CODE_ID = i.ITEM_TYPE_CODE_ID
                where
                    i.SKU = @sku and
                    pt.NAME = @typePrice and
                    i.IS_ACTIVE = 1 and
                    p.IS_ACTIVE = 1 and
                    it.NAME = ''PRODUCT_ITEM'';
                set @filas = @@ROWCOUNT;';

                DECLARE @sku VARCHAR(100), @typePrice VARCHAR(50), @price DECIMAL(16,4),
                        @fecha DATETIME, @filas INT, @error NVARCHAR(4000);

                DECLARE cur_updates CURSOR LOCAL STATIC FOR
                    SELECT c.sku, c.typePrice, c.Precio_Ganador, c.Fecha_Ganadora, k.caja, k.prefijo
                    FROM #comparativa AS c
                    JOIN #detalle AS d ON d.sku = c.sku AND d.typePrice = c.typePrice
                                      AND d.filas = 1 AND d.price <> c.Precio_Ganador
                    JOIN #cajas AS k ON k.cash_number = d.cash_number
                    WHERE c.Cajas_Actualizar IS NOT NULL
                    ORDER BY c.sku, c.typePrice, k.cash_number;

                OPEN cur_updates;
                FETCH NEXT FROM cur_updates INTO @sku, @typePrice, @price, @fecha, @caja, @prefijo;
                WHILE @@FETCH_STATUS = 0
                BEGIN
                    SELECT @error = NULL, @filas = NULL;
                    SET @sql = REPLACE(@update, N'{db}', @prefijo);
                    BEGIN TRY
                        EXEC sp_executesql @sql,
                             N'@sku varchar(100), @typePrice varchar(50), @price decimal(16,4),
                               @fecha datetime, @filas int OUTPUT',
                             @sku, @typePrice, @price, @fecha, @filas OUTPUT;
                        IF @filas <> 1
                            SET @error = N'Se actualizaron ' + CAST(@filas AS NVARCHAR(10))
                                       + N' precios en lugar de 1.';
                    END TRY
                    BEGIN CATCH
                        SET @error = ERROR_MESSAGE();
                    END CATCH;

                    -- Registrar transacción en la auditoría
                    INSERT dbo.Job_Homologacion_Precios_Log
                           (EjecucionID, SKU, PriceType, Caja, Previous_Price, Winning_Price,
                            Winning_Source_Caja, Winning_Date, Status, Error_Message)
                    SELECT @EjecucionID, @sku, @typePrice, @caja, d.price, @price,
                           c.Caja_Ganadora, @fecha,
                           CASE WHEN @error IS NULL THEN 'ACTUALIZADO' ELSE 'ERROR' END, @error
                    FROM #comparativa AS c
                    JOIN #detalle AS d ON d.sku = c.sku AND d.typePrice = c.typePrice AND d.caja = @caja
                    WHERE c.sku = @sku AND c.typePrice = @typePrice;

                    FETCH NEXT FROM cur_updates INTO @sku, @typePrice, @price, @fecha, @caja, @prefijo;
                END
                CLOSE cur_updates;
                DEALLOCATE cur_updates;

                -- Resultado por SKU
                UPDATE c
                   SET Resultado = CASE WHEN l.errores = 0  THEN 'ACTUALIZADO'
                                        WHEN l.ok = 0       THEN 'ERROR'
                                        ELSE 'PARCIAL' END
                FROM #comparativa AS c
                CROSS APPLY (SELECT SUM(CASE WHEN Status = 'ERROR' THEN 1 ELSE 0 END) AS errores,
                                    SUM(CASE WHEN Status = 'ACTUALIZADO' THEN 1 ELSE 0 END) AS ok
                             FROM dbo.Job_Homologacion_Precios_Log
                             WHERE EjecucionID = @EjecucionID
                               AND SKU = c.sku AND PriceType = c.typePrice) AS l
                WHERE c.Cajas_Actualizar IS NOT NULL;
            END

            /* -----------------------------------------------------------------
               Resultado de la ejecución
               ----------------------------------------------------------------- */
            SET @Status = CASE WHEN EXISTS (SELECT 1 FROM #comparativa
                                            WHERE Resultado IN ('ERROR', 'PARCIAL'))
                               THEN 'PARCIAL' ELSE 'OK' END;
            SET @Mensaje = CASE
                WHEN NOT EXISTS (SELECT 1 FROM #comparativa WHERE Estatus_Precios = 'DIFERENTES')
                     THEN N'Precios homologados.'
                WHEN @SoloReporte = 1
                     THEN N'Modo reporte: no se modificó ningún precio.'
                WHEN @Status = 'PARCIAL'
                     THEN N'Algunas cajas no se pudieron actualizar. Revisar la auditoría.'
                WHEN NOT EXISTS (SELECT 1 FROM #comparativa WHERE Cajas_Actualizar IS NOT NULL)
                     THEN N'Sin precios por actualizar. Hay SKUs por revisar.'
                ELSE N'Precios actualizados.' END;

            UPDATE dbo.Job_Homologacion_Precios_Ejecucion
               SET Status           = @Status,
                   Mensaje          = @Mensaje,
                   SKUs_Diferentes  = (SELECT COUNT(*) FROM #comparativa WHERE Estatus_Precios = 'DIFERENTES'),
                   SKUs_Actualizar  = (SELECT COUNT(*) FROM #comparativa WHERE Cajas_Actualizar IS NOT NULL),
                   SKUs_Por_Revisar = (SELECT COUNT(*) FROM #comparativa WHERE Accion LIKE '%REVISAR%'),
                   SKUs_Con_Error   = (SELECT COUNT(*) FROM #comparativa WHERE Resultado IN ('ERROR', 'PARCIAL'))
            WHERE EjecucionID = @EjecucionID;

            /* -----------------------------------------------------------------
               Tabla de lo que se cambiaría (o se cambió): una columna de precio
               y una de fecha por cada caja
               ----------------------------------------------------------------- */
            SELECT @cols_precio = STRING_AGG(CAST(
                       N'max(case when d.cash_number = ' + CAST(cash_number AS NVARCHAR(10))
                       + N' then d.price end) as ' + QUOTENAME(N'Precio_' + caja) AS NVARCHAR(MAX)), N', ')
                       WITHIN GROUP (ORDER BY cash_number),
                   @cols_fecha = STRING_AGG(CAST(
                       N'max(case when d.cash_number = ' + CAST(cash_number AS NVARCHAR(10))
                       + N' then d.fecha end) as ' + QUOTENAME(N'Fecha_' + caja) AS NVARCHAR(MAX)), N', ')
                       WITHIN GROUP (ORDER BY cash_number)
            FROM #cajas;

            SET @sql = N'set ansi_warnings off;
            select c.sku, c.typePrice, ' + @cols_precio + N',
                   c.Estatus_Precios, ' + @cols_fecha + N',
                   c.Precio_Ganador, c.Caja_Ganadora, c.Fecha_Ganadora, c.Accion, c.Resultado
            from #comparativa as c
            join #detalle as d on d.sku = c.sku and d.typePrice = c.typePrice
            where c.Estatus_Precios = ''DIFERENTES''
            group by c.sku, c.typePrice, c.Estatus_Precios, c.Precio_Ganador, c.Caja_Ganadora,
                     c.Fecha_Ganadora, c.Accion, c.Resultado
            order by c.sku asc, c.typePrice asc;';
            EXEC sp_executesql @sql;
        END

        SELECT EjecucionID, ExecutionDate, Modo, Status,
               (SELECT COUNT(*) FROM #cajas) AS Cajas,
               SKUs_Diferentes, SKUs_Actualizar, SKUs_Por_Revisar, SKUs_Con_Error, Mensaje
        FROM dbo.Job_Homologacion_Precios_Ejecucion
        WHERE EjecucionID = @EjecucionID;
    END TRY
    BEGIN CATCH
        SET @Mensaje = ERROR_MESSAGE();
        UPDATE dbo.Job_Homologacion_Precios_Ejecucion
           SET Status = 'ERROR', Mensaje = @Mensaje
        WHERE EjecucionID = @EjecucionID;

        EXEC sp_releaseapplock @Resource = N'Job_Homologacion_Precios', @LockOwner = N'Session';
        THROW;
    END CATCH

    EXEC sp_releaseapplock @Resource = N'Job_Homologacion_Precios', @LockOwner = N'Session';

    -- Cancelado o con errores: código de salida distinto de cero para la tarea programada
    IF @Status IN ('CANCELADO', 'PARCIAL')
        RAISERROR(@Mensaje, 16, 1);
END
GO


/* =============================================================================
   EJECUCIÓN
   ============================================================================= */
-- Solo mostrar lo que se cambiaría:
-- EXEC dbo.usp_Job_Homologacion_Precios @SoloReporte = 1;

-- Aplicar los cambios:
-- EXEC dbo.usp_Job_Homologacion_Precios @SoloReporte = 0;

